language js(typescript)

or {
  `play: $value` where {
    $value <: or {
      JsArrowFunctionExpression(),
      JsFunctionExpression(),
      `$_.play`
    }
  },
  `play($args) { $body }`,
  `$_.play = $_`
} as $play where {
  register_diagnostic(span=$play, message="Do not add a story play function. No check runs it. Use a story for a visual state only; see Tests in CONTRIBUTING.md.", severity="error")
}

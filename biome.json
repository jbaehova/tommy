{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "plugins": [
    "./tools/biome/anti-slop/rules/no-known-value-widening.grit",
    "./tools/biome/anti-slop/rules/no-module-mocking.grit",
    "./tools/biome/anti-slop/rules/no-object-parameters.grit",
    "./tools/biome/anti-slop/rules/no-reflect-escapes.grit",
    "./tools/biome/anti-slop/rules/no-unknown-returns.grit",
    "./tools/biome/anti-slop/rules/no-unknown-type-aliases.grit",
    "./tools/biome/anti-slop/rules/no-unsafe-dictionary-type.grit"
  ],
  "files": {
    "includes": [
      "**",
      "!!.codex",
      "!!.claude",
      "!node_modules",
      "!!out",
      "!!out-*",
      "!!build",
      "!!dist",
      "!!**/dist",
      "!!**/.wrangler",
      "!**/routeTree.gen.ts",
      "!tools/biome/anti-slop",
      "!!coverage",
      "!!.tommy-build",
      "!!Agents",
      "!!Bots",
      "!!Shared",
      "!!.worktrees",
      "!!.agents",
      "!marketplace/production-catalog/bundles"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Input", "Textarea", "NativeSelect"]
          }
        }
      },
      "complexity": {
        "noBannedTypes": "error",
        "noUselessTypeConstraint": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisleadingReturnType": "error",
        "noUnsafeTypeAssertion": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useAsConstAssertion": "error",
        "useReduceTypeParameter": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noFocusedTests": "error",
        "noImportCycles": "error",
        "noSkippedTests": "warn"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/contracts/src/**/*.ts", "!packages/contracts/src/**/*.test.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "packages/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.ts", "src/**/*.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "error"
          }
        }
      }
    },
    {
      "includes": ["src/main/**/*.ts", "src/backend/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/renderer/**"],
                    "message": "Nothing behind the trust boundary imports renderer code. Share the type through packages/contracts instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/contracts/src/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "electron",
                      "electron/**",
                      "solid-js",
                      "solid-js/**",
                      "@solidjs/**",
                      "cloudflare:*",
                      "@cloudflare/**",
                      "@anthropic-ai/**",
                      "@openai/**",
                      "openai",
                      "**/src/main/**",
                      "**/src/backend/**",
                      "**/src/preload/**",
                      "**/src/renderer/**",
                      "**/apps/**"
                    ],
                    "message": "Contracts are shared by every surface. Keep them free of Electron, SolidJS, provider, Cloudflare and application code."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "plugins": [
        "./tools/biome/anti-slop/rules/no-class-assertions.grit",
        "./tools/biome/anti-slop/rules/no-style-assertions.grit",
        "./tools/biome/anti-slop/rules/no-dom-containment-assertions.grit",
        "./tools/biome/anti-slop/rules/no-title-copy-assertions.grit",
        "./tools/biome/anti-slop/rules/no-active-element-assertions.grit",
        "./tools/biome/anti-slop/rules/no-inner-html-assertions.grit",
        "./tools/biome/anti-slop/rules/no-dom-traversal-assertions.grit",
        "./tools/biome/anti-slop/rules/no-icon-query-assertions.grit",
        "./tools/biome/anti-slop/rules/no-snapshot-tests.grit",
        "./tools/biome/anti-slop/rules/no-testid-queries.grit",
        "./tools/biome/anti-slop/rules/no-class-selector-queries.grit",
        "./tools/biome/anti-slop/rules/no-sleep-in-tests.grit"
      ]
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    },
    "jsxRuntime": "transparent"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  }
}

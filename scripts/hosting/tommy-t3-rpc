#!/usr/bin/env python3
# Stops a run or answers an approval on the T3 Code server of this computer. `tommy-t3` runs this
# with a short token, as the user of T3 Code. Only the Python standard library is on every server.
import base64
import http.client
import json
import os
import pathlib
import socket
import struct
import sys
import uuid

DECISIONS = ("accept", "acceptForSession", "decline", "cancel")


def usage():
    print(f"Usage: vps-t3 thread stop <thread id> | vps-t3 thread answer <thread id> <request id> <{'|'.join(DECISIONS)}>", file=sys.stderr)
    sys.exit(64)


def command(args):
    identity = str(uuid.uuid4())
    if len(args) == 2 and args[0] == "stop":
        return {"type": "thread.stop", "commandId": identity, "threadId": args[1], "reason": "Stopped by Tommy"}
    if len(args) == 4 and args[0] == "answer" and args[3] in DECISIONS:
        return {"type": "runtime-request.respond", "commandId": identity, "threadId": args[1], "requestId": args[2], "decision": args[3]}
    usage()


def socket_ticket(port, token):
    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=10)
    connection.request("POST", "/api/auth/websocket-ticket", body="{}", headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    response = connection.getresponse()
    body = response.read()
    if response.status != 200:
        sys.exit(f"T3 Code refused the session: HTTP {response.status}.")
    answer = json.loads(body)
    return answer.get("token") or answer.get("ticket")


def open_socket(port, ticket):
    connection = socket.create_connection(("127.0.0.1", port), timeout=15)
    key = base64.b64encode(os.urandom(16)).decode()
    connection.sendall((
        f"GET /ws?orchestrationProtocol=2&wsTicket={ticket} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\n"
        f"Upgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n"
    ).encode())
    data = b""
    while b"\r\n\r\n" not in data:
        chunk = connection.recv(4096)
        if not chunk:
            sys.exit("T3 Code closed the connection.")
        data += chunk
    head, rest = data.split(b"\r\n\r\n", 1)
    if b" 101 " not in head.split(b"\r\n")[0]:
        sys.exit(f"T3 Code refused the connection: {head.split(chr(13).encode())[0].decode()}.")
    return connection, rest


def send_text(connection, text):
    payload = text.encode()
    mask = os.urandom(4)
    size = len(payload)
    length = bytes([0x80 | size]) if size < 126 else bytes([0x80 | 126]) + struct.pack(">H", size)
    connection.sendall(bytes([0x81]) + length + mask + bytes(byte ^ mask[index % 4] for index, byte in enumerate(payload)))


def read_frames(connection, data):
    def need(count):
        nonlocal data
        while len(data) < count:
            chunk = connection.recv(65536)
            if not chunk:
                sys.exit("T3 Code closed the connection before it answered.")
            data += chunk

    while True:
        need(2)
        opcode, size, offset = data[0] & 15, data[1] & 127, 2
        if size == 126:
            need(4)
            size, offset = struct.unpack(">H", data[2:4])[0], 4
        elif size == 127:
            need(10)
            size, offset = struct.unpack(">Q", data[2:10])[0], 10
        need(offset + size)
        yield opcode, data[offset : offset + size]
        data = data[offset + size :]


def main():
    message = command(sys.argv[1:])
    home = pathlib.Path.home()
    port = json.loads((home / ".t3/userdata/server-runtime.json").read_text())["port"]
    connection, rest = open_socket(port, socket_ticket(port, os.environ["TOMMY_T3_TOKEN"]))
    send_text(connection, json.dumps({
        "_tag": "Request", "id": "1", "tag": "orchestration.dispatchCommand", "payload": message,
        "traceId": uuid.uuid4().hex, "spanId": uuid.uuid4().hex[:16], "sampled": False, "headers": [],
    }))
    for opcode, payload in read_frames(connection, rest):
        if opcode == 8:
            sys.exit("T3 Code closed the connection before it answered.")
        if opcode != 1:
            continue
        for entry in json.loads(payload) if payload.startswith(b"[") else [json.loads(payload)]:
            if entry.get("_tag") != "Exit" or entry.get("requestId") != "1":
                continue
            exit_value = entry.get("exit", {})
            if exit_value.get("_tag") == "Success":
                print(json.dumps({"ok": True, "commandId": message["commandId"]}))
                return
            sys.exit(f"T3 Code refused the command: {json.dumps(exit_value)[:400]}")


main()

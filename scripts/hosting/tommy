#!/bin/bash
# The terminal command of the Tommy server. It talks to the running app over the control socket in
# src/main/server-mode.ts. The socket is in /run/tommy, so run this with sudo or as the service user.
set -euo pipefail
umask 077

SOCKET=/run/tommy/control.sock
UNIT=tommy.service

fail() {
  echo "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: tommy <command>
  status               Show the state of the server.
  agents [--json]      List the agents that a handoff can reach.
  handoff --agent <id or name> --mode <work|record> [--source <text>] < summary
                       Give a session summary from another computer to one agent. Its Telegram
                       chat shows the handoff and the answer.
  ask --agent <id or name> [--source <text>] [--timeout <seconds>] [question]
                       Ask one agent a question and print its answer. Without a question argument,
                       the question comes from standard input. The agent's Telegram chat shows it
                       too. Waits up to --timeout seconds (default 600, at most 1800).
  t3 [list] [--json]   List the T3 Code links: the computers where agents can use T3 Code.
  t3 link --name <name> [--access <mode>] <address or pairing URL>
                       Link T3 Code on another computer. Run `t3 pair` there first. Give the
                       pairing URL it shows, or its address and then the code when asked.
                       --access: read-only, approval-required (default), auto-accept-edits, auto
                       or full-access. Agents get the tools of T3 Code from their next turn.
                       A link lasts 30 days. Telegram tells you 3 days before it ends.
  t3 unlink <name>     Remove a T3 Code link. Revoke it in T3 Code too, under Sharing & access.
  logs                 Follow the log of the service.
  restart              Restart the service (sudo).
EOF
}

# control <method> <path> [--data <body>]. Sets `response` to the answer lines and a last status line.
control() {
  local second
  for ((second = 0; second < 30; second++)); do
    [ -S "$SOCKET" ] && break
    if [ -d /run/tommy ] && [ ! -x /run/tommy ]; then fail "Run this with sudo, or as the user tommy."; fi
    systemctl is-active --quiet "$UNIT" || fail "Tommy is not running. Read the log with: tommy logs"
    sleep 1
  done
  [ -S "$SOCKET" ] || fail "Tommy does not answer. Read the log with: tommy logs"
  response=$(curl --silent --show-error --max-time "${CONTROL_MAX_TIME:-120}" --unix-socket "$SOCKET" -X "$@" \
    --write-out 'status=%{http_code}\n') || fail "Tommy does not answer. Read the log with: tommy logs"
}

value() {
  sed -n "s/^$1=//p" <<<"$response" | head -n 1
}

check_answer() {
  [ "$(value status)" = 200 ] && return 0
  fail "Tommy refused the request: $(value message)$(value error)"
}

case ${1:-} in
  status)
    control GET http://tommy/v1/status
    check_answer
    sed '/^status=/d' <<<"$response"
    ;;
  agents)
    control GET http://tommy/v1/agents
    check_answer
    agents=$(value agents)
    if [ "${2:-}" = --json ]; then
      printf '%s\n' "$agents"
    else
      python3 -c 'import json,sys
for a in json.loads(sys.argv[1]): print(a["id"], a["name"], a["provider"], "telegram" if a["chat"] else "-", sep="\t")' "$agents"
    fi
    ;;
  handoff)
    shift
    agent="" mode="" source=""
    while [ $# -gt 0 ]; do
      case $1 in
        --agent) agent=${2:-}; shift 2 ;;
        --mode) mode=${2:-}; shift 2 ;;
        --source) source=${2:-}; shift 2 ;;
        *) fail "Unknown option: $1" ;;
      esac
    done
    [ -n "$agent" ] && { [ "$mode" = work ] || [ "$mode" = record ]; } ||
      fail "Usage: tommy handoff --agent <id or name> --mode <work|record> [--source <text>] < summary"
    summary=$(mktemp)
    trap 'rm -f "$summary"' EXIT
    cat >"$summary"
    [ -s "$summary" ] || fail "The summary on standard input is empty."
    control POST http://tommy/v1/handoff --data-urlencode "agent=$agent" --data-urlencode "mode=$mode" \
      --data-urlencode "source=$source" --data-urlencode "text@$summary"
    check_answer
    sed '/^status=/d' <<<"$response"
    ;;
  ask)
    shift
    agent="" source="" timeout=600
    while [ $# -gt 0 ]; do
      case $1 in
        --agent) agent=${2:-}; shift 2 ;;
        --source) source=${2:-}; shift 2 ;;
        --timeout) timeout=${2:-}; shift 2 ;;
        --) shift; break ;;
        -*) fail "Unknown option: $1" ;;
        *) break ;;
      esac
    done
    usage_ask="Usage: tommy ask --agent <id or name> [--source <text>] [--timeout <seconds>] [question]"
    [ -n "$agent" ] || fail "$usage_ask"
    [[ $timeout =~ ^[0-9]+$ ]] && [ "$timeout" -ge 1 ] && [ "$timeout" -le 1800 ] ||
      fail "--timeout takes 1 to 1800 seconds."
    question=$(mktemp)
    trap 'rm -f "$question"' EXIT
    if [ $# -gt 0 ]; then printf '%s' "$*" >"$question"; else cat >"$question"; fi
    [ -n "$(tr -d '[:space:]' <"$question")" ] || fail "The question is empty. $usage_ask"
    CONTROL_MAX_TIME=$((timeout + 30)) control POST http://tommy/v1/ask --data-urlencode "agent=$agent" \
      --data-urlencode "source=$source" --data-urlencode "timeout=$timeout" --data-urlencode "text@$question"
    check_answer
    result=$(value result)
    value answer | base64 -d
    echo
    echo "agent=$(value agent_name) result=$result chat=$(value chat)" >&2
    case $result in
      completed) ;;
      pending)
        echo "No answer after $timeout seconds. The agent continues, and its answer appears in its chat." >&2
        exit 2
        ;;
      *) exit 1 ;;
    esac
    ;;
  t3)
    usage_link="Usage: tommy t3 link --name <name> [--access <mode>] <address or pairing URL>"
    case ${2:-list} in
      list | --json)
        control GET http://tommy/v1/t3
        check_answer
        links=$(value links)
        if [ "${2:-}" = --json ] || [ "${3:-}" = --json ]; then
          printf '%s\n' "$links"
        else
          python3 -c 'import json,sys
links = json.loads(sys.argv[1])
if not links: print("No T3 Code links. Add one with: sudo tommy t3 link --name <name> <address>")
for l in links: print(l["name"], l["origin"], l["access"], "until " + l["expiresAt"], "mcp " + l["mcp"], sep="\t")' "$links"
        fi
        ;;
      link)
        shift 2
        name="" access=approval-required address=""
        while [ $# -gt 0 ]; do
          case $1 in
            --name) name=${2:-}; shift 2 ;;
            --access) access=${2:-}; shift 2 ;;
            -*) fail "Unknown option: $1" ;;
            *) address=$1; shift ;;
          esac
        done
        [ -n "$name" ] && [ -n "$address" ] || fail "$usage_link"
        code=""
        # The pairing URL of `t3 pair` carries the code after #token=.
        if [[ $address == *"#token="* ]]; then
          code=${address##*#token=}
          address=${address%%#*}
        fi
        if [ -z "$code" ]; then
          if [ -t 0 ]; then
            read -rsp "Pairing code from t3 pair on that computer: " code
            echo >&2
          else
            read -r code || true
          fi
        fi
        [ -n "$code" ] || fail "The pairing code is empty. $usage_link"
        secret=$(mktemp)
        trap 'rm -f "$secret"' EXIT
        printf '%s' "$code" >"$secret"
        CONTROL_MAX_TIME=90 control POST http://tommy/v1/t3/link --data-urlencode "name=$name" \
          --data-urlencode "address=$address" --data-urlencode "access=$access" --data-urlencode "code@$secret"
        check_answer
        echo "Linked T3 Code $(value name) at $(value origin) with $(value access) access, until $(value expires_at)."
        echo "Agents get its tools as the MCP server $(value mcp_server) from their next turn."
        ;;
      unlink)
        [ -n "${3:-}" ] || fail "Usage: tommy t3 unlink <name>"
        control POST http://tommy/v1/t3/unlink --data-urlencode "name=$3"
        check_answer
        echo "Removed the T3 Code link $(value name). Revoke it in T3 Code at $(value origin) too, under Sharing & access."
        ;;
      *) fail "Usage: tommy t3 [list|link|unlink]" ;;
    esac
    ;;
  logs) exec journalctl --unit "$UNIT" --follow ;;
  restart)
    [ "$(id -u)" -eq 0 ] || fail "Run this with sudo."
    exec systemctl restart "$UNIT"
    ;;
  -h | --help | help | "") usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac

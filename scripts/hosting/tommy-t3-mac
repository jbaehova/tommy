#!/usr/bin/env python3
# Lists, reads, starts and messages T3 Code sessions on the user's Mac. T3 Code on this server holds a
# link to the Mac, and the credential of that link opens the MCP endpoint of the T3 Code on the Mac.
# `tommy-t3` runs this as the user of T3 Code, so the agents never read the credential. Only the
# operations below are available. Only the Python standard library is on every server.
import argparse
import datetime
import json
import pathlib
import sqlite3
import sys
import urllib.error
import urllib.request
import uuid

REQUEST_TIMEOUT_SECONDS = 60
THREAD_FIELDS = ("threadId", "projectId", "title", "status", "model", "runtimeMode", "updatedAt")


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """A redirect could send the credential to another origin."""

    def redirect_request(self, *_args, **_kwargs):
        return None


OPENER = urllib.request.build_opener(NoRedirect)


def stop(message):
    sys.exit(f"vps-t3 mac: {message}")


def linked_mac():
    home = pathlib.Path.home()
    state = home / ".t3/userdata/statev2.sqlite"
    links = sqlite3.connect(f"file:{state}?mode=ro", uri=True).execute(
        "select label, secret_name, urls_json, expires_at from peer_environment_links"
    ).fetchall()
    if len(links) != 1:
        stop(f"T3 Code on this server has {len(links)} linked computers, and this command needs exactly one.")
    label, secret_name, urls, expires_at = links[0]
    expires = datetime.datetime.fromisoformat(expires_at.replace("Z", "+00:00"))
    if expires <= datetime.datetime.now(datetime.timezone.utc):
        stop(f"The link to {label} expired on {expires_at}. The user must link it again with `t3 environment link`.")
    secrets = list((home / ".t3/userdata/secrets").glob(f"{secret_name}*"))
    if len(secrets) != 1:
        stop("The credential of the link is missing. The user must link the Mac again.")
    return label, json.loads(urls), secrets[0].read_text().strip()


class MacClient:
    def __init__(self):
        self.label, self.urls, self.token = linked_mac()
        self.session = None
        self.identity = 0

    def _post(self, base, method, params, notification=False):
        headers = {
            "Authorization": f"Bearer {self.token}",
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
            "User-Agent": "tommy-t3-mac",
        }
        if self.session:
            headers["Mcp-Session-Id"] = self.session
        body = {"jsonrpc": "2.0", "method": method, "params": params}
        if not notification:
            self.identity += 1
            body["id"] = self.identity
        request = urllib.request.Request(f"{base}/mcp", json.dumps(body).encode(), headers, method="POST")
        with OPENER.open(request, timeout=REQUEST_TIMEOUT_SECONDS) as response:
            self.session = response.headers.get("mcp-session-id") or self.session
            text = response.read().decode()
        if notification:
            return None
        for line in text.splitlines():
            if line.startswith("data:"):
                text = line[5:]
        answer = json.loads(text)
        if "error" in answer:
            stop(f"T3 Code on the Mac refused the request: {json.dumps(answer['error'], ensure_ascii=False)[:400]}")
        return answer["result"]

    def open(self):
        failure = None
        for url in self.urls:
            base = url.rstrip("/")
            try:
                self._post(base, "initialize", {
                    "protocolVersion": "2025-06-18",
                    "capabilities": {},
                    "clientInfo": {"name": "tommy-t3-mac", "version": "1"},
                })
                self._post(base, "notifications/initialized", {}, notification=True)
                self.base = base
                return
            except (OSError, ValueError) as cause:
                failure = cause
        status = f" (HTTP {failure.code})" if isinstance(failure, urllib.error.HTTPError) else ""
        stop(f"{self.label} does not answer{status}. It can be asleep or off, or T3 Code can be closed there.")

    def call(self, name, arguments):
        try:
            result = self._post(self.base, "tools/call", {"name": name, "arguments": arguments})
        except urllib.error.HTTPError as cause:
            stop(f"T3 Code on the Mac refused the request: HTTP {cause.code}.")
        except (OSError, ValueError):
            # The request can have arrived. Say so, because a repeat of `send` can make a second turn.
            stop(f"The connection to {self.label} ended before it answered. Read the session to see if the request arrived.")
        text = "\n".join(part.get("text", "") for part in result.get("content", []))
        if result.get("isError"):
            stop(f"T3 Code on the Mac refused the request: {text[:400]}")
        return text


def message_of(value):
    text = sys.stdin.read() if value == "-" else value
    if not text.strip():
        stop("The message is empty.")
    return text


def print_json(value):
    print(json.dumps(value, ensure_ascii=False, indent=2))


def projects(client, _args):
    answer = json.loads(client.call("t3_project_list", {"limit": 100}))
    print_json([
        {"id": project["id"], "title": project["title"], "path": project["workspaceRoot"]}
        for project in answer["projects"]
        if not project.get("archivedAt")
    ])


def thread_list(client, args):
    arguments = {"limit": args.limit}
    if args.project:
        arguments["projectId"] = args.project
    else:
        arguments["allProjects"] = True
    if args.title:
        arguments["titleContains"] = args.title
    answer = json.loads(client.call("t3_thread_list", arguments))
    print_json([{field: thread.get(field) for field in THREAD_FIELDS} for thread in answer["threads"]])


def thread_show(client, args):
    print(client.call("t3_thread_read", {
        "threadId": args.thread,
        "view": "messages",
        "limit": args.messages,
        "maxCharsPerItem": args.max_chars,
    }))


def thread_start(client, args):
    arguments = {"title": args.title, "message": message_of(args.message), "clientRequestId": str(uuid.uuid4())}
    if args.scratch:
        arguments["scratch"] = True
    else:
        arguments["projectId"] = args.project
    print(client.call("t3_thread_launch", arguments))


def thread_send(client, args):
    # A queued message is the next turn of the session. It never interrupts a run.
    print(client.call("t3_thread_send", {
        "threadId": args.thread,
        "message": message_of(args.message),
        "mode": "queue",
        "clientRequestId": str(uuid.uuid4()),
    }))


def parser():
    root = argparse.ArgumentParser(prog="vps-t3 mac")
    commands = root.add_subparsers(dest="command", required=True)
    commands.add_parser("projects").set_defaults(run=projects)
    threads = commands.add_parser("thread").add_subparsers(dest="action", required=True)

    listing = threads.add_parser("list")
    listing.add_argument("--project")
    listing.add_argument("--title")
    listing.add_argument("--limit", type=int, default=20, choices=range(1, 101), metavar="1-100")
    listing.set_defaults(run=thread_list)

    show = threads.add_parser("show")
    show.add_argument("thread")
    show.add_argument("--messages", type=int, default=20, choices=range(1, 101), metavar="1-100")
    show.add_argument("--max-chars", type=int, default=4000, choices=range(1, 50001), metavar="1-50000")
    show.set_defaults(run=thread_show)

    start = threads.add_parser("start")
    start.add_argument("--title", required=True)
    target = start.add_mutually_exclusive_group(required=True)
    target.add_argument("--project")
    target.add_argument("--scratch", action="store_true")
    start.add_argument("message", help="The message, or - to read it from standard input.")
    start.set_defaults(run=thread_start)

    send = threads.add_parser("send")
    send.add_argument("thread")
    send.add_argument("message", help="The message, or - to read it from standard input.")
    send.set_defaults(run=thread_send)
    return root


def main():
    args = parser().parse_args()
    client = MacClient()
    client.open()
    args.run(client, args)


main()

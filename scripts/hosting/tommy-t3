#!/bin/bash
# The T3 Code of this server, for the agents of Tommy. T3 Code runs as the user t3code. The sudo rule
# that tommy-install writes lets the service user run only this file as that user.
set -euo pipefail

if [ "$(id -un)" != t3code ]; then
  exec sudo --non-interactive --user=t3code --set-home "$(readlink -f "$0")" "$@"
fi
cd "$HOME"
T3="$HOME/.local/bin/t3"

case "${1:-} ${2:-}" in
  "projects "*)
    # T3 Code has no command that lists projects.
    exec python3 -c '
import json, os, sqlite3
state = os.path.expanduser("~/.t3/userdata/statev2.sqlite")
rows = sqlite3.connect(f"file:{state}?mode=ro", uri=True).execute(
    "select project_id, title, workspace_root from projection_projects where deleted_at is null order by title")
print(json.dumps([{"id": r[0], "title": r[1], "path": r[2]} for r in rows], indent=2))'
    ;;
  "thread list" | "thread start" | "thread send" | "thread show")
    exec "$T3" "$@" --log-level error
    ;;
  "thread stop" | "thread answer")
    # T3 Code has no command for these, so they go to its server as its own clients send them.
    token=$("$T3" auth session issue --token-only --ttl 1m --label tommy-control \
      --scope orchestration:read --scope orchestration:operate --log-level error | head -n 1)
    TOMMY_T3_TOKEN="$token" exec python3 "$(dirname "$(readlink -f "$0")")/tommy-t3-rpc" "${@:2}"
    ;;
  "mac "*)
    # The T3 Code on the user's Mac, through the link that T3 Code on this server holds.
    exec python3 "$(dirname "$(readlink -f "$0")")/tommy-t3-mac" "${@:2}"
    ;;
  *)
    echo "Usage: vps-t3 projects | vps-t3 thread <list|start|send|show|stop|answer> ... | vps-t3 mac <projects|thread> ..." >&2
    exit 64
    ;;
esac

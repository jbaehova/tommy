#!/bin/bash
# Installs the unpacked Linux build as Tommy, as root, from the root of a built checkout:
#
#   bash scripts/hosting/tommy-install dist/linux-unpacked [https://tommy.example.com]
#
# The optional second argument is the public HTTPS address of the server (the one that
# nginx-tommy.conf serves). It goes into /etc/tommy/server.env, and pairing codes name it. Give it
# again only to change it.
#
# Each path, the user and the unit are its own, so a Tommy install on the same computer keeps
# running. Run it again to upgrade. The data in /var/lib/tommy stays.
set -euo pipefail

SOURCE=$(cd "$(dirname "$0")" && pwd)
RELEASE=${1:?Name the unpacked build.}
PUBLIC_URL=${2:-}
INSTALL=/opt/Tommy
USER_NAME=tommy

[ "$(id -u)" -eq 0 ] || { echo "Run this as root." >&2; exit 1; }
[ -x "$RELEASE/tommy" ] || { echo "$RELEASE has no tommy executable." >&2; exit 1; }
case "$PUBLIC_URL" in
  "" | https://*) ;;
  *) echo "The public address must start with https://." >&2; exit 1 ;;
esac
id "$USER_NAME" >/dev/null 2>&1 ||
  useradd --system --create-home --home-dir "/var/lib/$USER_NAME" --shell /bin/bash "$USER_NAME"

# The packages that tommy-server and the app need on a Debian or Ubuntu server: a virtual display
# (xvfb), a session bus and a keyring for Electron safeStorage, the runtime libraries of Electron,
# and for Computer Use (agent-desktop) the AT-SPI accessibility bus and a window manager. A name
# with `|` is a list of alternatives: Ubuntu 24.04 adds `t64` to some library names.
if command -v apt-get >/dev/null; then
  installed() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "install ok installed"; }
  wanted=()
  for choice in xvfb xauth dbus dbus-user-session gnome-keyring at-spi2-core libatk-adaptor openbox \
    libnss3 "libgtk-3-0t64|libgtk-3-0" "libasound2t64|libasound2" libgbm1 libsecret-1-0 libxss1; do
    have=no
    for candidate in ${choice//|/ }; do installed "$candidate" && have=yes; done
    [ "$have" = yes ] || wanted+=("$choice")
  done
  if [ ${#wanted[@]} -gt 0 ]; then
    apt-get update -q
    missing=()
    for choice in "${wanted[@]}"; do
      package=""
      for candidate in ${choice//|/ }; do
        if apt-cache show "$candidate" >/dev/null 2>&1; then package=$candidate; break; fi
      done
      [ -n "$package" ] || { echo "No package for $choice." >&2; exit 1; }
      missing+=("$package")
    done
    DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends "${missing[@]}"
  fi
else
  echo "This is not a Debian or Ubuntu system. Install the packages above with your package manager." >&2
fi

systemctl stop tommy.service 2>/dev/null || true
install -d -m 0755 "$INSTALL" "$INSTALL/hosted"
staged="$INSTALL/app.new"
rm -rf "$staged"
cp -a "$RELEASE" "$staged"
chown -R root:root "$staged"
# Chromium refuses a sandbox helper with other modes, and `--no-sandbox` is never the answer.
chmod -R u+rwX,go=rX "$staged"
chmod 4755 "$staged/chrome-sandbox"
rm -rf "$INSTALL/app.old"
[ ! -e "$INSTALL/app" ] || mv "$INSTALL/app" "$INSTALL/app.old"
mv "$staged" "$INSTALL/app"
rm -rf "$INSTALL/app.old"

install -m 0755 "$SOURCE/tommy-server" "$INSTALL/hosted/tommy-server"
install -m 0755 "$SOURCE/tommy" "$INSTALL/hosted/tommy"
ln -sfn "$INSTALL/hosted/tommy" /usr/local/bin/tommy

# The settings of this server that are not secret. The unit reads them.
install -d -m 0755 /etc/tommy
if [ -n "$PUBLIC_URL" ]; then
  printf 'TOMMY_PUBLIC_URL=%s\n' "$PUBLIC_URL" >/etc/tommy/server.env
  chmod 0644 /etc/tommy/server.env
elif ! grep -qs '^TOMMY_PUBLIC_URL=https://' /etc/tommy/server.env; then
  echo "No public address is set, so pairing codes name no server. Run this again with the address." >&2
fi
install -m 0644 "$SOURCE/tommy.service" /etc/systemd/system/tommy.service
# The keys that the agents use (OP_SERVICE_ACCOUNT_TOKEN and others), one per line. Each agent gets them,
# except TOMMY_OP_PAYMENT_TOKEN: Tommy takes that one out of its environment when it starts.
install -d -o "$USER_NAME" -g "$USER_NAME" -m 0700 "/var/lib/$USER_NAME/.config" "/var/lib/$USER_NAME/.config/tommy"
install -d -o "$USER_NAME" -g "$USER_NAME" -m 0755 "/var/lib/$USER_NAME/bin"

# Ubuntu 24.04 limits user namespaces. This profile lets the Chromium sandbox make them.
cat >/etc/apparmor.d/tommy <<EOF
abi <abi/4.0>,
include <tunables/global>

profile tommy $INSTALL/app/tommy flags=(unconfined) {
  userns,
  network,
}
EOF
if command -v apparmor_parser >/dev/null && [ -d /sys/kernel/security/apparmor ]; then
  apparmor_parser --replace /etc/apparmor.d/tommy
fi

systemctl daemon-reload
systemctl enable --now tommy.service
echo "Installed Tommy. Pair a device with: sudo tommy pair"

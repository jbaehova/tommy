# Copy this file to .env and fill the values you need. Git ignores .env. Every value is optional.
# On a Linux server, set these in /etc/tommy/server.env (mode 0600) instead.

# Telegram interface for one server owner. Set all three to enable it. Store the manager token in
# a private file readable by the service user. Use the public HTTPS origin without a path.
TOMMY_TELEGRAM_MANAGER_TOKEN_FILE=
TOMMY_TELEGRAM_OWNER_ID=
TOMMY_TELEGRAM_PUBLIC_URL=
# The time zone for times in Telegram chats, such as Asia/Seoul. Empty uses the time zone of your
# routines, then the server's own (often UTC).
TOMMY_TIMEZONE=
# The loopback port that nginx forwards the Telegram and webhook paths to. Empty uses 8790.
TOMMY_DIRECT_PORT=
# HTTPS origin for signed workflow webhooks, such as https://tommy.example.com. Empty disables ingress.
TOMMY_WEBHOOK_PUBLIC_URL=
# Credential-bearing connector JSON. See docs/INSTALL.md. Keep actual values out of git.
TOMMY_WORKFLOW_CONNECTORS_JSON=
# Linux only: key-file permits new secrets to use a private AES key file if the OS keyring fails.
# Empty keeps the normal keyring policy. This cannot recover secrets encrypted with a lost keyring.
TOMMY_SECRET_STORAGE_FALLBACK=

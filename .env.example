# Copy this file to .env and fill the values you need. Git ignores .env. Every value is optional.
# A new worktree copies .env from the main checkout (see .worktreeinclude).

# The server address that the desktop pairing screen starts with, such as tommy.example.com.
RENDERER_VITE_DEFAULT_SERVER_ADDRESS=

# Android: the signing key to keep between builds. A leading ~/ is the home folder.
TOMMY_ANDROID_KEYSTORE=

# Android notifications: the values of your own Firebase project.
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_NUMBER=
FIREBASE_STORAGE_BUCKET=

# Optional host-only settings. For Linux services, set these in /etc/tommy/server.env (mode 0600).
# HTTPS origin for signed workflow webhooks, such as https://tommy.example.com. Empty disables ingress.
TOMMY_WEBHOOK_PUBLIC_URL=
# Credential-bearing connector JSON. See docs/INSTALL.md. Keep actual values out of git.
TOMMY_WORKFLOW_CONNECTORS_JSON=
# Linux only: key-file permits new secrets to use a private AES key file if the OS keyring fails.
# Empty keeps the normal keyring policy. This cannot recover secrets encrypted with a lost keyring.
TOMMY_SECRET_STORAGE_FALLBACK=

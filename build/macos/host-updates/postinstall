#!/bin/sh
set -eu
export PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C
ROOT='/Library/Application Support/Tommy/HostManager'
"$ROOT/tommy-host" --verify-installation
# Payload files have explicit root:wheel modes. Never recurse through tenant status or homes.
if [ -f "$ROOT/config.json" ] && [ ! -L "$ROOT/config.json" ]; then
  launchctl bootstrap system /Library/LaunchDaemons/app.tommy.host-manager.plist
fi
echo 'Tommy Host installed. Run sudo tommy-host setup, then sudo tommy-host verify.'

{
  "name": "tommy",
  "productName": "Tommy",
  "desktopName": "tommy.desktop",
  "version": "0.59.0",
  "description": "A personal workspace for AI agents: one server, with Mac and Android apps.",
  "author": {
    "name": "Johnny Bae",
    "url": "https://github.com/jbaehova"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbaehova/tommy.git"
  },
  "bugs": {
    "url": "https://github.com/jbaehova/tommy/issues"
  },
  "homepage": "https://github.com/jbaehova/tommy#readme",
  "keywords": [
    "ai-agents",
    "bun",
    "claude-code",
    "codex",
    "electron",
    "local-first",
    "solidjs"
  ],
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@noble/hashes": "2.4.0",
      "@paper-design/shaders": "0.0.80",
      "@fontsource-variable/inter": "5.3.0",
      "@kobalte/core": "2.0.0-alpha.0",
      "@norbert_bodziony/bloub": "0.6.1",
      "@solidjs/signals": "2.0.0-rc.18",
      "@solidjs/testing-library": "1.0.0-rc.2",
      "@solidjs/vite-plugin": "3.0.0-next.51",
      "@solidjs/web": "2.0.0-rc.18",
      "@speed-highlight/core": "1.2.24",
      "@tailwindcss/vite": "4.3.3",
      "@testing-library/jest-dom": "7.0.1",
      "@types/bun": "1.4.4",
      "@types/node": "24.19.2",
      "class-variance-authority": "0.7.1",
      "fflate": "0.8.3",
      "jsdom": "30.0.1",
      "katex": "0.19.0",
      "marked": "18.1.1",
      "mermaid": "12.2.0",
      "pdfjs-dist": "6.4.299",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2",
      "vite": "8.3.5",
      "vitest": "4.1.12",
      "yaml": "2.9.1",
      "zod": "4.6.7",
      "lucide-solid": "1.33.0",
      "solid-sonner": "0.3.2",
      "solid-recharts": "1.0.1",
      "qrcode": "^1.5.4",
      "@tanstack/virtual-core": "3.19.7",
      "effect": "4.0.6"
    }
  },
  "main": "./out/main/index.js",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "bun scripts/install-git-hooks.ts",
    "prepare:agent-desktop": "bun scripts/agent-desktop-stage.mjs",
    "postinstall": "bun scripts/electron-dist-cache.ts restore && bun scripts/install-electron.ts && bun scripts/electron-dist-cache.ts save && bun scripts/stamp-install.ts",
    "dev:prepare": "bun scripts/prepare-dev-environment.ts",
    "dev": "bun scripts/dev-services.ts app",
    "dev:automation": "bun scripts/dev-automation/cli.ts",
    "dev:status": "bun scripts/dev-stack.ts status",
    "dev:stop": "bun scripts/dev-stack.ts stop",
    "dev:forget": "bun scripts/dev-stack.ts forget",
    "dev:restart-client": "bun scripts/dev-stack.ts restart-client",
    "mobile": "bun run --cwd apps/mobile start",
    "mobile:android": "bun run --cwd apps/mobile android",
    "mobile:android:build:local": "bun run --cwd apps/mobile android:build:local",
    "mobile:lint": "bun run --cwd apps/mobile lint",
    "build": "electron-vite build",
    "typecheck:node": "bun scripts/type-checker.ts --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "bun scripts/type-checker.ts --noEmit -p tsconfig.web.json",
    "typecheck:brand": "bun run --cwd packages/brand typecheck",
    "typecheck:contracts": "bun run --cwd packages/contracts typecheck",
    "typecheck:logging": "bun run --cwd packages/logging typecheck",
    "typecheck:user-errors": "bun run --cwd packages/user-errors typecheck",
    "typecheck:i18n": "bun run --cwd packages/i18n typecheck",
    "typecheck:team-client": "bun run --cwd packages/team-client typecheck",
    "typecheck:mobile": "bun run --cwd apps/mobile typecheck",
    "typecheck": "bun run --parallel 'typecheck:*'",
    "lint": "biome check --max-diagnostics=none .",
    "format": "biome check --write --max-diagnostics=none .",
    "i18n:check": "bun scripts/i18n-check.ts",
    "check:staged": "biome check --write --staged --files-ignore-unknown=true --no-errors-on-unmatched",
    "check:ui": "bun scripts/ui-foundation-check.ts",
    "test:desktop": "vitest run",
    "test:changed": "git merge-base origin/main HEAD > /dev/null && vitest run --changed origin/main --maxWorkers=1",
    "test:related": "vitest related --run --maxWorkers=1",
    "test:backend": "vitest run src/backend",
    "verify:preload": "bun scripts/verify-preload-bundle.ts",
    "mobile:typecheck": "bun run typecheck:mobile",
    "package": "bun run build && electron-builder --dir --mac",
    "package:linux": "bun run build && electron-builder --dir --linux --x64 --publish never",
    "dist:mac": "bun run build && electron-builder --mac --publish never",
    "dist:linux": "bun run build && electron-builder --linux AppImage --x64 --publish never"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.309",
    "@anthropic-ai/sdk": "0.137.0",
    "@fontsource-variable/inter": "catalog:",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@kobalte/core": "catalog:",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@noble/hashes": "catalog:",
    "@norbert_bodziony/bloub": "catalog:",
    "@tommy/brand": "workspace:*",
    "@tommy/contracts": "workspace:*",
    "@tommy/i18n": "workspace:*",
    "@tommy/logging": "workspace:*",
    "@tommy/team-client": "workspace:*",
    "@tommy/ui": "workspace:*",
    "@tommy/user-errors": "workspace:*",
    "@paper-design/shaders": "catalog:",
    "@solidjs/web": "catalog:",
    "@speed-highlight/core": "catalog:",
    "@tanstack/virtual-core": "catalog:",
    "class-variance-authority": "catalog:",
    "cuelume": "0.2.8",
    "effect": "catalog:",
    "fflate": "catalog:",
    "katex": "catalog:",
    "koffi": "3.3.5",
    "lucide-solid": "catalog:",
    "marked": "catalog:",
    "qrcode": "catalog:",
    "quickjs-emscripten-core": "0.32.0",
    "solid-js": "2.0.0-rc.18",
    "solid-recharts": "catalog:",
    "solid-sonner": "catalog:",
    "tldts": "7.4.19",
    "ws": "8.22.0",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@dotenvx/dotenvx": "^2.38.2",
    "@electron/fuses": "1.8.0",
    "@solidjs/testing-library": "catalog:",
    "@solidjs/vite-plugin": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "8.18.2",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "catalog:",
    "knip": "6.42.1",
    "playwright-core": "1.64.1",
    "tailwindcss": "catalog:",
    "tsrs": "0.16.0-ts7.1.0-dev.20260929",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "patchedDependencies": {
    "lucide-solid@1.33.0": "patches/lucide-solid@1.33.0.patch",
    "@kobalte/core@2.0.0-alpha.0": "patches/@kobalte%2Fcore@2.0.0-alpha.0.patch",
    "dmg-builder@26.18.0": "patches/dmg-builder@26.18.0.patch",
    "solid-sonner@0.3.2": "patches/solid-sonner@0.3.2.patch",
    "solid-recharts@1.0.1": "patches/solid-recharts@1.0.1.patch",
    "expo@58.0.17": "patches/expo@58.0.17.patch",
    "expo-splash-screen@58.0.11": "patches/expo-splash-screen@58.0.11.patch",
    "react-native-keyboard-controller@1.22.7": "patches/react-native-keyboard-controller@1.22.7.patch",
    "react-native-uitextview@2.7.1": "patches/react-native-uitextview@2.7.1.patch",
    "@react-native-masked-view/masked-view@0.3.2": "patches/@react-native-masked-view%2Fmasked-view@0.3.2.patch",
    "react-native-reserved-regions@0.2.0": "patches/react-native-reserved-regions@0.2.0.patch",
    "cuelume@0.2.8": "patches/cuelume@0.2.8.patch",
    "react-native-screens@4.30.0": "patches/react-native-screens@4.30.0.patch"
  },
  "trustedDependencies": [
    "electron-winstaller",
    "esbuild",
    "workerd"
  ]
}
